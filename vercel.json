{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|manifest\\.webmanifest|sw\\.js|workbox-.*|offline\\.html|icon\\.svg|apple-touch-icon\\.png|pwa-.*).*)",
      "destination": "/index.html"
    }
  ]
}
