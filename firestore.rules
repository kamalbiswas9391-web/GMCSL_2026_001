rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Token-only admin check (safe inside allow list: zero DB reads)
    function isAdminToken() {
      return isVerified() && request.auth.token.email == 'kamalbiswas9391@gmail.com';
    }

    // Full admin check for single-document operations
    function isAdmin() {
      return isAdminToken() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidRole(role) {
      return role in ['System', 'President', 'Secretary', 'Member'];
    }

    function isValidModule(mod) {
      return mod in [
        'members',
        'savings',
        'shares',
        'loans',
        'cash_book',
        'attendance',
        'loan_applications',
        'online_payments',
        'meetings',
        'notices',
        'receipts',
        'certificates',
        'society_settings'
      ];
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'memberId', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role is string
        && isValidRole(data.role)
        && (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'mobileNumber', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string
        && data.email.size() <= 180
        && (!('mobileNumber' in data) || (data.mobileNumber is string && data.mobileNumber.size() <= 20))
        && data.updatedAt is timestamp;
    }

    function isValidSyncRecord(data) {
      return data.keys().hasAll(['recordId', 'module', 'ownerUid', 'isDeleted', 'recordVersion', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'recordId',
          'module',
          'ownerUid',
          'memberId',
          'summary',
          'status',
          'amount',
          'fields',
          'isDeleted',
          'recordVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.recordId is string
        && isValidId(data.recordId)
        && data.module is string
        && isValidModule(data.module)
        && data.ownerUid is string
        && isValidId(data.ownerUid)
        && (!('memberId' in data) || (data.memberId is string && data.memberId.size() <= 64))
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 300))
        && (!('status' in data) || (data.status is string && data.status.size() <= 64))
        && (!('amount' in data) || (data.amount is number))
        && (!('fields' in data) || (data.fields is map && data.fields.keys().size() <= 40))
        && data.isDeleted is bool
        && data.recordVersion is number
        && data.recordVersion >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == adminUid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 180
        && data.grantedBy is string
        && data.grantedBy.size() >= 1
        && data.grantedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Connectivity health probe document
    match /test/{docId} {
      allow get: if isValidId(docId) && docId == 'connection';
      allow list, write: if false;
    }

    // Admin grant directory
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdminToken();
      allow create: if isValidId(adminUid)
        && isAdmin()
        && isValidAdminGrant(incoming(), adminUid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(adminUid)
        && isAdmin()
        && isValidAdminGrant(incoming(), adminUid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'grantedBy', 'updatedAt']);
      allow delete: if isValidId(adminUid) && isAdmin();
    }

    // User profile & isolated PII / personal records
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerified() && (isOwner(userId) || isAdmin());
      allow list: if isAdminToken();
      allow create: if isValidId(userId)
        && isVerified()
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && (incoming().role != 'System' || isAdmin())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'memberId', 'updatedAt'])
          )
        );
      allow delete: if isValidId(userId) && isVerified() && (isOwner(userId) || isAdmin());

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && isVerified() && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(docId)
          && isVerified()
          && (isOwner(userId) || isAdmin())
          && existsAfter(/databases/$(database)/documents/users/$(userId))
          && isValidPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(docId)
          && isVerified()
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'mobileNumber', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && isVerified() && (isOwner(userId) || isAdmin());
      }

      // User-owned offline-cached society records (never auto-deleted)
      match /records/{recordId} {
        allow get: if isValidId(userId) && isValidId(recordId) && isVerified() && (isOwner(userId) || isAdmin());
        allow list: if isVerified() && (isOwner(userId) || isAdminToken());
        allow create: if isValidId(userId)
          && isValidId(recordId)
          && isVerified()
          && (isOwner(userId) || isAdmin())
          && existsAfter(/databases/$(database)/documents/users/$(userId))
          && isValidSyncRecord(incoming())
          && incoming().recordId == recordId
          && incoming().ownerUid == userId
          && incoming().isDeleted == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(recordId)
          && isVerified()
          && isValidSyncRecord(incoming())
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().recordId == existing().recordId
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin() ||
            (
              isOwner(userId)
              && existing().isDeleted == false
              && incoming().diff(existing()).affectedKeys().hasOnly(['summary', 'status', 'amount', 'fields', 'isDeleted', 'recordVersion', 'updatedAt'])
            )
          );
        allow delete: if isValidId(userId) && isValidId(recordId) && isVerified() && (isOwner(userId) || isAdmin());
      }
    }

    // Shared society records (strictly owner-scoped or verified admin)
    match /society_records/{recordId} {
      allow get: if isValidId(recordId) && isVerified() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (resource.data.ownerUid == request.auth.uid || isAdminToken());
      allow create: if isValidId(recordId)
        && isVerified()
        && isValidSyncRecord(incoming())
        && incoming().recordId == recordId
        && incoming().ownerUid == request.auth.uid
        && incoming().isDeleted == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(recordId)
        && isVerified()
        && isValidSyncRecord(incoming())
        && incoming().recordId == existing().recordId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid
            && existing().isDeleted == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['summary', 'status', 'amount', 'fields', 'isDeleted', 'recordVersion', 'updatedAt'])
          )
        );
      allow delete: if isValidId(recordId) && isVerified() && (existing().ownerUid == request.auth.uid || isAdmin());
    }
  }
}
